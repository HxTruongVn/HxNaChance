{
  "_comment": "WorkshopManifest — Photo owns its UI; Core owns lifecycle/context.",
  "workshop_id": "photo",
  "version": "1.0.1",
  "description": "Nhận ảnh chân dung gốc, phục hồi/làm đẹp khuôn mặt đúng vùng, căn chỉnh chuẩn ảnh thẻ, tách nền.",
  "environment": {
    "python_version": ">=3.10",
    "device_preference": "auto",
    "min_ram_gb": 8
  },
  "ui": {
    "module": "workshops.photo.shortcut_ui",
    "mixin_class": "ShortcutProcessTabMixin",
    "build_method": "_build_process_tab",
    "menu_build_method": "_menu_photo_content",
    "open_method": "_run_single"
  },
  "execution": {
    "run_method": "_run_photo_current"
  },
  "shortcuts": {
    "Ctrl+O": "choose_files",
    "Ctrl+Shift+O": "choose_folder",
    "F2": "preview",
    "Ctrl+R": "run"
  },
  "capabilities_required": ["face_parser", "face_restorer", "upscaler", "background_remover"],
  "capabilities_optional": ["pose_estimator"],
  "resources": {
    "registry_file": "model_registry.json",
    "weight_sources_file": "weights_sources.json",
    "weights_directory": "weights/",
    "capabilities_file": "capabilities_registry.json"
  },
  "default_spec": "13x18",
  "output_settings": {
    "format": "jpg",
    "dpi": 300,
    "auto_save": true
  },
  "about_file": "ABOUT.md",
  "io": {
    "produces": ["image"]
  }
}
