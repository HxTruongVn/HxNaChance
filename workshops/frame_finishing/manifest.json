{
  "_comment": "Self-hosted Workshop: NaChance chỉ discovery/kiểm tra boundary, không dựng UI nội bộ của Shop.",
  "workshop_id": "frame_finishing",
  "version": "0.2.0",
  "resource_contract_version": 1,
  "description": "Đóng khung và hoàn thiện một ảnh hoặc cả thư mục ảnh trước khi chuyển sang Layout.",
  "self_hosted": true,
  "launcher": {
    "module": "workshops.frame_finishing.__main__",
    "callable": "main",
    "mode": "process"
  },
  "contract": {
    "version": 1,
    "input": ["image", "folder"],
    "output": ["image", "asset_collection"],
    "orientation_aware": true,
    "batch_preview_group_size": 4
  },
  "environment": {
    "python_version": ">=3.10",
    "device_preference": "cpu_only",
    "min_ram_gb": 2,
    "dependencies": ["Pillow"]
  },
  "capabilities_required": [],
  "capabilities_optional": [
    "orientation_detection",
    "image_frame",
    "folder_batch",
    "crop_anchor",
    "caf_fill",
    "rounded_corners",
    "frame_shadow"
  ],
  "resources": {
    "presets_file": "presets/frame_presets.json",
    "resource_declarations_file": "resources.json"
  },
  "default_spec": "legacy_border",
  "output_settings": {
    "format": "png",
    "dpi": 300,
    "auto_save": false
  },
  "about_file": "ABOUT.md",
  "io": {
    "accepts": ["image", "folder"],
    "produces": ["image", "asset_collection"]
  }
}
