{
  "_comment": "WorkshopManifest — Layout owns its UI; Core owns lifecycle/context.",
  "workshop_id": "layout",
  "version": "1.0.1",
  "description": "Xếp ảnh đã xử lý (hoặc ảnh bất kỳ) vào khổ in theo công thức bố cục, tối ưu số lượng ảnh trên tờ giấy.",
  "environment": {
    "python_version": ">=3.10",
    "device_preference": "cpu_only",
    "min_ram_gb": 2
  },
  "ui": {
    "module": "workshops.layout.shortcut_ui",
    "mixin_class": "ShortcutLayoutTabMixin",
    "build_method": "_build_layout_tab",
    "menu_build_method": "_menu_layout_content",
    "open_method": "_choose_layout_src"
  },
  "execution": {
    "run_method": "_layout_run_current"
  },
  "shortcuts": {
    "Ctrl+O": "choose_source",
    "Ctrl+Shift+O": "add_source",
    "F2": "preview",
    "Ctrl+R": "run"
  },
  "capabilities_required": [],
  "capabilities_optional": [],
  "resources": {
    "layout_presets_file": "layout_presets.json"
  },
  "default_spec": null,
  "output_settings": {
    "format": "jpg",
    "dpi": 300,
    "auto_save": false
  },
  "about_file": "ABOUT.md",
  "io": {
    "accepts": ["image"]
  }
}
